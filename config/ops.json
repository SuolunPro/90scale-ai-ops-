{
  "version": "2.0",
  "site": "https://suolunpro.github.io",
  "site_repo": "SuolunPro/suolunpro.github.io",
  "ops_repo": "SuolunPro/90scale-ai-ops-",
  "thresholds": {
    "sync_lag_fail_min": 40,
    "settlement_overdue_warn_h": 3,
    "settlement_overdue_fail_h": 8,
    "probe_timeout_s": 20,
    "site_min_bytes": 50000
  },
  "engine": {
    "workflow_file": "build-engine4.yml",
    "audit_workflow": "public-refresh-audit.yml"
  },
  "probes": [
    {
      "id": "sporttery",
      "name": "体彩官方接口",
      "url": "https://webapi.sporttery.cn/gateway/jc/football/getMatchCalculatorV1.qry?channel=c&poolCode=had,hhad,crs,ttg,hafu",
      "required": true,
      "cn_only": true,
      "min_bytes": 500,
      "headers": {
        "Referer": "https://m.sporttery.cn/",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/140 Safari/537.36"
      }
    },
    {
      "id": "qiulaile",
      "name": "球来了镜像",
      "url": "https://qiulaile.vip/api/matches?matchType=0&mode=full",
      "required": false,
      "cn_only": true,
      "min_bytes": 500,
      "headers": {
        "Referer": "https://qiulaile.vip/",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/140 Safari/537.36"
      }
    },
    {
      "id": "fotmob",
      "name": "FotMob",
      "url": "https://www.fotmob.com/api/data/matches?date={today_compact}",
      "required": false,
      "min_bytes": 500,
      "headers": {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/140 Safari/537.36"
      }
    },
    {
      "id": "okooo",
      "name": "澳客竞彩",
      "url": "https://www.okooo.com/jingcai/{today}/",
      "required": false,
      "cn_only": true,
      "min_bytes": 2000,
      "headers": {
        "Accept-Language": "zh-CN,zh;q=0.9",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/140 Safari/537.36"
      }
    }
  ],
  "budget": {
    "cap_cny": 10.0,
    "reserve_cny": 0.3,
    "model": "deepseek-chat",
    "max_output_tokens": 800,
    "temperature": 0.2,
    "max_calls_per_day": 12,
    "warn_dedupe_min": 120,
    "fail_dedupe_min": 45,
    "prices": {
      "deepseek-chat": {
        "input": 2.0,
        "output": 8.0
      },
      "deepseek-reasoner": {
        "input": 4.0,
        "output": 16.0
      }
    }
  },
  "handoff": {
    "tasks_dir": "tasks",
    "reports_dir": "reports",
    "state_dir": "state",
    "sla_minutes": {
      "P0": 15,
      "P1": 60,
      "P2": 240
    }
  },
  "executor": {
    "enabled": true,
    "max_tasks_per_run": 3,
    "max_attempts": 2,
    "allowed_actions": [
      "site_probe",
      "inspect_all",
      "engine_runs_audit",
      "workflow_runs"
    ]
  },
  "watchdog": {
    "enabled": false,
    "auto_apply": false,
    "note": "补偿由公开 public-refresh-audit.yml 根据实际销售及防重证据执行"
  },
  "recovery": {
    "enabled": true,
    "max_per_hour": 2,
    "stop_sale_window_bj": [
      "08:45",
      "22:45"
    ],
    "require_confirm_phrase": "YES-I-APPROVE",
    "note": "写生产的恢复动作必须人工 workflow_dispatch + 授权串；代码修复只能走 PR"
  },
  "recovery_plans": {
    "engine_missed_run": {
      "class": "operational",
      "action": "dispatch_public_audit",
      "allow_in_sale": true,
      "max_per_hour": 1,
      "writes_frozen_data": false,
      "preconditions": {
        "engine_runs": [
          "WARN",
          "FAIL"
        ],
        "engine_fresh": [
          "WARN",
          "FAIL"
        ]
      },
      "description": "请求公开自检复验，由现有在售及防重闸门决定是否补偿。以公开快照和正式站内容验收"
    },
    "site_sync_failure": {
      "class": "operational",
      "action": "dispatch_public_audit",
      "allow_in_sale": true,
      "max_per_hour": 2,
      "writes_frozen_data": false,
      "preconditions": {
        "site_data_sync": [
          "WARN",
          "FAIL"
        ]
      },
      "description": "请求公开自检复验，由现有在售及防重闸门决定是否补偿。以公开快照和正式站内容验收"
    },
    "collector_failure": {
      "class": "operational",
      "action": "none",
      "allow_in_sale": false,
      "max_per_hour": 0,
      "writes_frozen_data": false,
      "preconditions": {
        "sources": [
          "WARN",
          "FAIL"
        ]
      },
      "description": "采集链路失败只出报告，不自动换源；换源属于代码变更，必须走 PR"
    },
    "code_fix": {
      "class": "code",
      "action": "none",
      "allow_in_sale": false,
      "writes_frozen_data": false,
      "description": "生产代码修复必须走 ops/fix_pr.py：测试 → 独立分支 → PR → 人工审核，恢复通道拒绝执行"
    }
  },
  "deepseek": {
    "base_url": "https://api.deepseek.com"
  },
  "private_audit_repo": "SuolunPro/90scale-engine"
}
